{
  "name": "florida-probation-law",
  "version": "0.1.0",
  "private": true,
  "description": "FloridaProbationLaw.com — static site for Hoffman Legal",
  "type": "module",
  "scripts": {
    "build": "npm run build:html && npm run build:css && npm run check:contrast && npm run check:seo && npm run check:links && npm run check:content && npm run check:placeholders",
    "build:html": "node scripts/build.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "build:production": "BASE_PATH= npm run build",
    "dev": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch",
    "check": "npm run lint && node scripts/build.mjs --check && npm run check:contrast && npm run check:seo && npm run check:links && npm run check:content",
    "lint": "node scripts/lint.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:launch": "node scripts/check-placeholders.mjs --strict",
    "audit": "node scripts/audit-responsive.mjs && node scripts/audit-a11y.mjs",
    "audit:responsive": "node scripts/audit-responsive.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "playwright": "^1.49.0",
    "tailwindcss": "^4.3.3"
  }
}
