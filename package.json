{
  "name": "florida-probation-law",
  "version": "0.1.0",
  "private": true,
  "description": "FloridaProbationLaw.com — static site for Hoffman Legal",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run check:contrast",
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "dev": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
