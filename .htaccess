# Generated by scripts/build.mjs from data/redirects.json — do not edit.
# Apache and LiteSpeed read this file; Netlify and Cloudflare read
# _redirects instead. Both are written so a move between hosts does not
# silently drop the redirect map.

# Serve the site's own 404 page rather than the host's default. Without
# this, a mistyped URL gets a generic error page with no way back.
ErrorDocument 404 /404.html

# No directory listings: a URL that resolves to a folder without an
# index should 404, not enumerate what is in it.
Options -Indexes

# URL changes made while the site was being built.
Redirect 301 /early-termination/eligibility-requirements/ /early-termination-of-probation/eligibility/
Redirect 301 /early-termination/florida-50-percent-rule/ /early-termination-of-probation/50-percent-rule/
Redirect 301 /early-termination/faq/ /early-termination-of-probation/faqs/
RedirectMatch 301 ^/early-termination/(.*)$ /early-termination-of-probation/$1
Redirect 301 /florida-law/probation-law-guide/ /florida-probation-law/
Redirect 301 /florida-law/probation-glossary/ /florida-probation-law/glossary/
RedirectMatch 301 ^/florida-law/(.*)$ /florida-probation-law/$1
Redirect 301 /probation-services/community-control/ /probation-services/community-control-termination/
Redirect 301 /legal/privacy-policy/ /privacy-policy/
Redirect 301 /legal/terms-of-use/ /terms-of-use/
Redirect 301 /legal/disclaimer/ /legal-disclaimer/
Redirect 301 /legal/accessibility/ /accessibility/
